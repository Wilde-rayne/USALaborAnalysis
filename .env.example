# ---------------------------------------------------------------------------
# Prairie Insights / USA Labor Analysis — environment template.
#
# Usage:
#   cp .env.example .env
#   # then fill in the values below
#
# This file is safe to commit. The real .env is git-ignored.
# docker-compose picks up the repo-root .env automatically for variable
# substitution (see docker-compose.yml).
# ---------------------------------------------------------------------------

# --- BLS (Bureau of Labor Statistics) ------------------------------------
# Optional. Without a key: capped at 25 queries/day and 10-year series window.
# With a key: 500 queries/day and 20-year series window.
# Free signup: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# --- US Census Bureau ----------------------------------------------------
# REQUIRED for ACS/PEP population endpoints.
# Free signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# --- Bureau of Economic Analysis ----------------------------------------
# Optional. Needed for the BEA SAINC1 (state per-capita personal income)
# data source — skip if you don't plan to run the fetch_bea_* agent.
# Free signup: https://apps.bea.gov/API/signup/
BEA_API_KEY=

# --- Ollama (local LLM) --------------------------------------------------
# These have sensible defaults in constants.py; override only if needed.
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=llama2:chat
# OLLAMA_CHAT_PATH=/v1/chat/completions
# OLLAMA_EMBED_PATH=/api/embeddings
# OLLAMA_TIMEOUT=180

# --- Startup behaviour ---------------------------------------------------
# PRELOAD_SCOPE controls what the app's background thread warms up before
# the UI becomes responsive. Tabs lazy-load anything skipped here on
# first interaction.
#   none         pure reactive — data, embeddings, models all on demand.
#   data         DEFAULT — ensure data/all_data.json exists (cache-hit if
#                fresh). Container ready in seconds when data is cached.
#   embeddings   + warm the embeddings cache so first chat is snappy.
#   lfp          + train the ~10 LFP LSTM models (~1 min).
#   full         + train 540 supersector × horizon models (~45 min).
# PRELOAD_SCOPE=data

# How long (in seconds) a cached data/all_data.json is considered fresh
# before ensure_data() triggers a re-fetch from BLS/Census. Default 7d.
# CACHE_MAX_AGE_SECONDS=604800
