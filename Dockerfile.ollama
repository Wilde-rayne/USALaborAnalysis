# ───── builder stage ─────
FROM ubuntu:22.04 AS builder

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Bind to localhost so we can pull from it
ENV OLLAMA_HOST=127.0.0.1 \
    OLLAMA_PORT=11434

# Start server temporarily, pull only the chat model, then kill
RUN ollama serve & \
    until curl -sf http://localhost:11434/api/version; do sleep 1; done && \
    ollama pull llama2:chat && \
    pkill ollama

# ───── final stage ─────
FROM ubuntu:22.04

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Install Ollama again
RUN curl -fsSL https://ollama.com/install.sh | sh

# Copy over the pre-pulled models
COPY --from=builder /root/.ollama /root/.ollama

# Listen externally
ENV OLLAMA_HOST=0.0.0.0 \
    OLLAMA_PORT=11434

EXPOSE 11434

HEALTHCHECK --interval=30s --timeout=5s \
  CMD curl --fail http://localhost:11434/api/version || exit 1

ENTRYPOINT ["ollama", "serve"]
